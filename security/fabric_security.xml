<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fabric" model="ir.module.category">
        <field name="name">Quản lý Cấp phát Vải</field>
        <field name="sequence">20</field>
    </record>

    <!-- MỚI THÊM: Odoo 19 bắt buộc phải có record này -->
    <record id="privilege_fabric" model="res.groups.privilege">
        <field name="name">Quản lý Cấp phát Vải</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_fabric"/>
    </record>

    <record id="group_fabric_user" model="res.groups">
        <field name="name">Nhân viên Kho / Phòng Cắt</field>
        <field name="privilege_id" ref="privilege_fabric"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')),
                                         (4, ref('mrp.group_mrp_user'))]"/>
    </record>

    <record id="group_fabric_qc" model="res.groups">
        <field name="name">Nhân viên QC</field>
        <field name="privilege_id" ref="privilege_fabric"/>
        <field name="implied_ids" eval="[(4, ref('group_fabric_user'))]"/>
    </record>

    <record id="group_fabric_manager" model="res.groups">
        <field name="name">Quản lý Kho / Phòng Cắt / Thu mua</field>
        <field name="privilege_id" ref="privilege_fabric"/>
        <field name="implied_ids" eval="[(4, ref('group_fabric_qc')),
                                         (4, ref('stock.group_stock_manager')),
                                         (4, ref('purchase.group_purchase_manager')),
                                         (4, ref('mrp.group_mrp_manager'))]"/>
    </record>

    <!-- MỚI THÊM: nhóm riêng cho Thu mua, không kèm quyền Quản lý Kho (stock.group_stock_manager) -->
    <record id="group_fabric_purchase_manager" model="res.groups">
        <field name="name">Quản lý Thu mua</field>
        <field name="privilege_id" ref="privilege_fabric"/>
        <field name="implied_ids" eval="[(4, ref('group_fabric_user')),
                                         (4, ref('purchase.group_purchase_manager'))]"/>
    </record>
</odoo>