<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fabric_shortage_wizard_form" model="ir.ui.view">
        <field name="name">fabric.shortage.wizard.form</field>
        <field name="model">fabric.shortage.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo xuất thiếu vải">
                <group>
                    <field name="picking_id"/>
                    <field name="purchase_order_id"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="expected_date"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_create_report" type="object" string="Tạo báo cáo thiếu"
                            class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fabric_shortage_wizard" model="ir.actions.act_window">
        <field name="name">Báo xuất thiếu vải</field>
        <field name="res_model">fabric.shortage.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
