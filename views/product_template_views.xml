<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_fabric" model="ir.ui.view">
        <field name="name">product.template.form.fabric</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Định mức Vải (FR-07)" name="fabric_defaults_page">
                    <field name="is_fabric"/>
                    <group name="fabric_defaults" invisible="not is_fabric">
                        <field name="default_fabric_gsm"/>
                        <field name="default_fabric_width"/>
                        <field name="default_fabric_waste_percent"/>
                        <field name="fabric_norm_variance_threshold"/>
                        <field name="fabric_lead_time_days"/>
                        <field name="fabric_safety_stock_days"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>